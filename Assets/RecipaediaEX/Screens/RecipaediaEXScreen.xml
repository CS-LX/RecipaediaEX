<Screen xmlns="runtime-namespace:Game">

	<PanoramaWidget />

	<StackPanelWidget Direction="Horizontal">

		<CanvasWidget Style="{Widgets/TopBarContents}" >
			<LabelWidget Name="TopBar.Label" Text="[RecipaediaScreen:0]" />
		</CanvasWidget>

		<StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">

			<CanvasWidget Size="0, 10" />

			<StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="10, 0">
				<BevelledButtonWidget Style="{Styles/ButtonStyle_ArrowLeft}" Name="PreviousCategory" Margin="8, 0" VerticalAlignment="Center"/>
				<CanvasWidget Size="220, 60" VerticalAlignment="Center">
					<LabelWidget Name="Category" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</CanvasWidget>
				<BevelledButtonWidget Style="{Styles/ButtonStyle_ArrowRight}" Name="NextCategory" Margin="8, 0" VerticalAlignment="Center"/>
				<CanvasWidget Size="12, 0"/>
				<CanvasWidget VerticalAlignment="Center" Size="280, 50" Margin="0, 5">
					<BevelledRectangleWidget Style="{Styles/TextBoxArea}" />
					<LabelWidget Name="placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Text="[RecipaediaSearch:0]" Color="96, 96, 96"/>
					<TextBoxWidget Name="key" Size="Infinity, 60" VerticalAlignment="Center" Margin="10, 0"/>
					<LinkWidget Name="ClearSearchLink" Text="[OriginalCommunityContentScreen:7]" Color="64, 192, 64" HorizontalAlignment="Far" VerticalAlignment="Center" DropShadow="true" Margin="10, 0" />
				</CanvasWidget>
				<CanvasWidget Size="5, 0"/>
				<BevelledButtonWidget Name="Search" Text="[CommunityContentScreen:10]" Style="{Styles/ButtonStyle_115x60}" VerticalAlignment="Center"/>
				<BevelledButtonWidget Name="SearchType" Text="[RecipaediaSearch:1]" Style="{Styles/ButtonStyle_115x60}" VerticalAlignment="Center"/>
			</StackPanelWidget>

			<CanvasWidget Size="0, 10" />

			<StackPanelWidget Direction="Vertical" Margin="20, 0">
				<CanvasWidget>
					<BevelledRectangleWidget Style="{Styles/Area}" />
					<ListPanelWidget Name="BlocksList" Direction="Vertical" Margin="5, 3" ItemSize="70" SelectionColor="10, 70, 0, 90"/>
				</CanvasWidget>
			</StackPanelWidget>

			<CanvasWidget Size="0, 10" />

			<StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="0, 0">
				<BevelledButtonWidget Name="DetailsButton" Style="{Styles/ButtonStyle_310x60}" Text="[RecipaediaScreen:1]" HorizontalAlignment="Center"/>
				<CanvasWidget Size="20, 0" />
				<BevelledButtonWidget Name="RecipesButton" Style="{Styles/ButtonStyle_310x60}" Text="[RecipaediaScreen:2]" HorizontalAlignment="Center"/>
			</StackPanelWidget>

			<CanvasWidget Size="0, 10" />

		</StackPanelWidget>

	</StackPanelWidget>

</Screen>

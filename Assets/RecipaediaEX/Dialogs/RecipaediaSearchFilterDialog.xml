            <StackPanelWidget Direction="Horizontal" Margin="0, 4">
              <CanvasWidget Size="150, 46">
                <LabelWidget Text="[RecipaediaSearchFilterDialog:1]" VerticalAlignment="Center" HorizontalAlignment="Far" />
              </CanvasWidget>
              <CanvasWidget Size="10, 0" />
              <CanvasWidget Size="Infinity, 46" VerticalAlignment="Center">
                <BevelledRectangleWidget Style="{Styles/TextBoxArea}" />
                <TextBoxWidget Name="RecipaediaSearchFilterDialog.Name" Color="255, 255, 255" Margin="8, 0" VerticalAlignment="Center" Size="Infinity, 46" MaximumLength="128" />
              </CanvasWidget>
            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal" Margin="0, 4">
              <CanvasWidget Size="150, 46" />
              <CanvasWidget Size="10, 0" />
              <CheckboxWidget Name="RecipaediaSearchFilterDialog.HasRecipe" Text="[RecipaediaSearchFilterDialog:2]" VerticalAlignment="Center" />

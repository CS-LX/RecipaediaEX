<CanvasWidget xmlns="runtime-namespace:Game">

  <CanvasWidget Size="640, 500" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
    <BevelledRectangleWidget Style="{Styles/DialogArea}" />
    <StackPanelWidget Direction="Vertical" Margin="16, 10, 16, 8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

      <LabelWidget Name="RecipaediaSearchFilterDialog.Title" Text="[RecipaediaSearchFilterDialog:0]" HorizontalAlignment="Center" Color="255, 255, 255" />

      <CanvasWidget Size="0, 8" />

      <CanvasWidget Size="Infinity, Infinity" ClampToBounds="true">
        <ScrollPanelWidget Direction="Vertical" Margin="4, 4" ClampToBounds="true">

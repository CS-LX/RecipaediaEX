            </StackPanelWidget>

            <StackPanelWidget Direction="Horizontal" Margin="0, 4">
              <CanvasWidget Size="150, 46">
                <LabelWidget Text="[RecipaediaSearchFilterDialog:12]" VerticalAlignment="Center" HorizontalAlignment="Far" />
              </CanvasWidget>
              <CanvasWidget Size="10, 0" />

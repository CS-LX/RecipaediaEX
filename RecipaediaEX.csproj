	<!-- 构建前从 modinfo.json 同步版本号 -->
	<Target Name="SyncVersion" BeforeTargets="Build" Condition="'$(RecipaediaEXSkipSyncVersion)' != 'true'">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\sync-version.ps1&quot;"/>
	</Target>
	<!-- 打包并部署 .scmod 到游戏 Mods 文件夹 -->
	<!-- 需在 tools\pack.config.json 中配置本机路径（参考 tools\pack.config.example.json） -->
	<Target Name="PackMod" AfterTargets="Build" Condition="'$(RecipaediaEXSkipPack)' != 'true'">
		<PropertyGroup>
			<_TargetDirSafe>$(TargetDir.TrimEnd('\'))</_TargetDirSafe>
		</PropertyGroup>
		<Message Text="[PackMod] Target fired. TargetDir=$(_TargetDirSafe)" Importance="High"/>
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\pack.ps1&quot; -BuildOutputDir &quot;$(_TargetDirSafe)&quot; -Configuration &quot;$(Configuration)&quot;"/>
	</Target>
